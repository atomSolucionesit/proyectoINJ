# Conexión a MySQL (la usan Prisma y el servidor). Con docker-compose.yml queda así:
DATABASE_URL="mysql://inj:inj_local_2026@localhost:3306/instituto"

# Puerto del backend y dirección del frontend (para CORS).
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Clave para firmar las sesiones (JWT). En producción: al azar y de 32 caracteres o más.
#   Generala con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambiame-por-una-clave-larga-y-secreta"

# Minutos que dura una sesión. Pasado ese tiempo hay que volver a ingresar.
SESION_MINUTOS=60

# Clave para cifrar las contraseñas que el administrador puede ver en Usuarios (otra clave al azar, distinta de JWT_SECRET).
# Si la cambiás, las contraseñas guardadas dejan de verse (siguen funcionando para ingresar).
PASSWORD_KEY="cambiame-por-otra-clave-larga-y-secreta"

# Contraseña que reciben todas las cuentas nuevas (y las de prueba del seed).
PASSWORD_INICIAL="pasodeloslibres"

# Cuenta universal del superadministrador: se crea (o se actualiza) sola al arrancar el servidor.
# Con ella se entra a Usuarios para crear al resto. No se puede borrar ni editar desde el panel.
# En producción SUPERADMIN_PASSWORD es obligatoria y de 12 caracteres o más.
SUPERADMIN_NOMBRE="Superadministrador INJ"
SUPERADMIN_PASSWORD=""
SUPERADMIN_EMAIL="superadmin@instituto.local"

# Carpeta donde se guardan los archivos subidos a la biblioteca.
UPLOAD_DIR="./uploads"
